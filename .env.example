# ==============================================================================
# TicketWorld Platform - Environment Variables Template
# Copy this file to .env and set secure production/dev credentials
# DO NOT COMMIT THE ACTUAL .env FILE TO GIT!
# ==============================================================================

# Database (PostgreSQL 16)
POSTGRES_DB=ticketworld_db
POSTGRES_USER=ticketworld_admin
POSTGRES_PASSWORD=ChangeMe_StrongPostgresPassword2026!
POSTGRES_PORT=5432

# Cache & Distributed Lock (Redis 7)
REDIS_PASSWORD=ChangeMe_StrongRedisPassword2026!
REDIS_PORT=6379

# Object Storage (MinIO)
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=ChangeMe_MinioAdminPassword2026!
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Structured Logging (Seq)
SEQ_ADMIN_PASSWORD=ChangeMe_SeqAdminPassword2026!
SEQ_INGESTION_PORT=5341
SEQ_UI_PORT=8081

# Mock Email (MailDev)
MAILDEV_WEB_PORT=1080
MAILDEV_SMTP_PORT=1025

# Application Security & JWT
JWT_SECRET=ReplaceWithAtLeast64CharactersLongSecretKeyForJwtSigningInTicketWorldPlatform2026!
JWT_ISSUER=TicketWorldAuthServer
JWT_AUDIENCE=TicketWorldClients
AES_ENCRYPTION_KEY=ChangeMe_32ByteBase64KeyForAES256GCM==

# Payment Gateway
PAYMENT_WEBHOOK_SECRET=whsec_test_stripe_or_omise_secret
STRIPE_SECRET_KEY=sk_test_mock_key
